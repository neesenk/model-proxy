.DS_Store
dist/
back/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
*.tmp
*.bak-*
*.bak

# Local runtime/cache files
.cache/
.env
.env.*
.playwright-mcp

# Build artifacts (Go binaries built inside the source dir, repo root).
/model-proxy
/model-proxy-linux
/model-proxy-linux-*
/model-proxy.exe

# Test binaries dropped in the working dir by `go test -cpuprofile/-memprofile`
# (named after the profiled package, e.g. app.test).
*.test

# Coverage artifacts from scripts/cover.sh
/cov.out
/coverage.html

# Agent/IDE session state
.omx/
*.swp
.zcode/
.orca/
.claude/

# runtime config write lock
config.yaml.lock

# Local daemon runtime state (credential/token backups) — never commit
.model-proxy/
